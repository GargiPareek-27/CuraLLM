# Copy to .env (scripts/setup does this). Never commit .env.
# POSTGRES_PASSWORD: 12+ characters, letters/digits/_/- only (it is placed inside a connection URL).
POSTGRES_USER=curallm
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=curallm

# Host ports (all bound to 127.0.0.1).
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8000
INFERENCE_HOST_PORT=8001

# Phase 1 supports only "mock".
INFERENCE_PROVIDER=mock

# Comma-separated explicit origins. "*" is rejected.
CORS_ORIGINS=http://localhost:3000
